---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Rita Morales Hernández - Alexandra Palenzuela Clinic',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->
  <Hero id="hero" title="Rita Morales" tagline='<span style="color: #EB9C9B">Nutritionist</span>' />

  <!-- Content Widget **************** -->
  <Content
    id="about"
    image={{
      src: '~/assets/images/rita.webp',
      alt: 'Rita Morales Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>

      <p>
        Specialist in Human Nutrition and Dietetics, dedicated to improving health through a balanced and personalized diet.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    id="education"
    title="Education"
    items={[
      {
        title:
          'University Master\'s Degree in Sports Training and Nutrition <br /> <span class="font-normal">European University of Madrid</span>',
        description: ``,
        icon: 'tabler:school',
      },
      {
        title:
          'Graduate in Human Nutrition and Dietetics <br /> <span class="font-normal">Fernando Pessoa-Canarias University (UFP-C)</span>',
        description: ``,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl', items: { icon: 'text-[#EB9C9B] border-[#EB9C9B]' } }}
  />

  <!-- BlogLatestPost Widget **************** -->
  <BlogLatestPosts id="blog" title="Discover more information on our blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</PageLayout>
