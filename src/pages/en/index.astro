---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Alexandra Palenzuela Clinic — Gynecology, Nutrition and Physiotherapy',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero image={{ src: '~/assets/images/portada.svg', alt: 'Alexandra Palenzuela Clinic Logo' }}>
    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        We believe in evidence-based medicine and the latest scientific advances, allowing us to offer each patient the
        most precise approach. We incorporate state-of-the-art diagnostic tests to find the best health for women.</span
      >
    </Fragment>
  </Hero>

  <!-- Gynecology Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Annual gynecological check-up and pap smears',
        description:
          'We perform annual gynecological check-ups and pap smears to ensure the health and well-being of our patients.',
        icon: 'tabler:wand',
      },
      {
        title: 'Estrogen metabolism study',
        description:
          'We conduct estrogen metabolism studies to better understand the hormonal health of our patients.',
        icon: 'tabler:settings',
      },
      {
        title: 'Vaginal bacteria balance study',
        description:
          'We study the balance of vaginal bacteria to better understand the vaginal health of our patients.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Intestinal dysbiosis. Know your microbiota',
        description:
          'We perform intestinal dysbiosis studies to better understand our patients\' microbiota.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: '~/assets/images/ginecologia.webp',
      alt: 'Gynecology - Alexandra Palenzuela Clinic',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Gynecology
      </h3>
    </Fragment>
  </Content>

  <!-- Nutrition Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Personalized nutritional plans',
        description:
          'We create personalized nutritional plans for each patient, adapted to their specific needs and goals.',
        icon: 'tabler:list',
      },
      {
        title: 'Nutritional education for different life stages',
        description:
          'We provide nutritional education adapted to different life stages, promoting healthy habits and integral well-being.',
        icon: 'tabler:school',
      },
      {
        title: 'Dietary treatment for pathologies (diabetes, obesity, etc.)',
        description:
          'We offer specialized dietary treatment for various pathologies, including diabetes, obesity, and other conditions, adapted to individual needs.',
        icon: 'tabler:health-recognition',
      },
      {
        title: 'Advice on supplementation and healthy habits',
        description:
          'We offer advice on supplementation and healthy habits to improve the general well-being of our patients.',
        icon: 'tabler:treadmill',
      },
    ]}
    image={{
      src: '~/assets/images/nutricion.webp',
      alt: 'Nutrition - Alexandra Palenzuela Clinic',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Nutrition
      </h3>
    </Fragment>
  </Content>

  <!-- Physiotherapy Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Pelvic floor rehabilitation',
        description:
          'We offer personalized pelvic floor rehabilitation programs to improve the function and well-being of our patients.',
        icon: 'tabler:wand',
      },
      {
        title: 'Treatment of muscular and joint pain',
        description:
          'We offer specialized treatment for muscular and joint pain, adapted to the individual needs of each patient.',
        icon: 'tabler:settings',
      },
      {
        title: 'Physiotherapy for pregnancy and postpartum',
        description:
          'We offer specialized physiotherapy programs for pregnancy and postpartum, adapted to the individual needs of each patient.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Functional recovery exercises and injury prevention',
        description:
          'We offer functional recovery exercises and injury prevention programs, adapted to the individual needs of each patient.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: '~/assets/images/fisioterapia.webp',
      alt: 'Physiotherapy - Alexandra Palenzuela Clinic',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Physiotherapy
      </h3>
    </Fragment>
  </Content>

  <!-- Obstetrics Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Comprehensive pregnancy tracking',
        description:
          'Personalized medical accompaniment during all stages of gestation to guarantee the health of the mother and the baby.',
        icon: 'tabler:heart-plus',
      },
      {
        title: 'Advice and doubt resolution',
        description:
          'We provide a space of trust to resolve all your concerns about pregnancy, the development of the baby and the changes in your body.',
        icon: 'tabler:message-2',
      },
      {
        title: 'Prenatal control and diagnosis',
        description:
          'We perform the necessary tests and check-ups to monitor the development of the pregnancy and ensure the peace of mind of the future parents.',
        icon: 'tabler:stethoscope',
      },
      {
        title: 'Postpartum care',
        description:
          'Medical follow-up after birth to ensure an optimal recovery and accompany the mother in the first weeks after delivery.',
        icon: 'tabler:nurse',
      },
    ]}
    image={{
      src: '~/assets/images/obstetricia.webp',
      alt: 'Obstetrics - Alexandra Palenzuela Clinic',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Obstetrics
      </h3>
    </Fragment>
  </Content>

  <!-- Online Consultation Hero -->
  <Hero
    tagline=""
    title="Online Consultation Service"
    subtitle="We put at your disposal an online medical consultation service, designed to accompany you and resolve all your doubts about women's health without you having to travel. <br /> <br />
Through a direct video consultation with Dr. Palenzuela, you can receive personalized guidance, evaluate test results or comment on any symptoms that concern you, all from the comfort and privacy of your home. <br /><br />
Ideal for follow-up consultations, review of analytics or evaluation of treatments."
    actions={[]}
    image={{
      src: '~/assets/images/consulta-online.webp',
      alt: 'Online Consultation',
    }}
  />

  <!-- BlogLatestPost Widget ******* -->
  <BlogLatestPosts title="More content in our Blog" />
</Layout>
