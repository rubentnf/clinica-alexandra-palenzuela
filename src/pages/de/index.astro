---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Klinik Alexandra Palenzuela — Gynäkologie, Ernährung und Physiotherapie',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero image={{ src: '~/assets/images/portada.svg', alt: 'Klinik Alexandra Palenzuela' }}>
    <Fragment slot="subtitle">
      <p class="mb-4">Wir behandeln keine Symptome, wir kümmern uns um Menschen.</p>
      <p class="mb-4">
        Wir verbinden Wissenschaft, Innovation und einen ganzheitlichen Ansatz, um Sie in Ihrer Gesundheit und Ihrem
        Wohlbefinden zu begleiten.
      </p>
      <p>
        Wir betreuen Frauen und Männer durch ein multidisziplinäres Team – Gynäkologie, Geburtshilfe, integrative
        Medizin, Physiotherapie und Ernährung –, um in jeder Lebensphase umfassende, personalisierte und nachhaltige
        Lösungen anzubieten.
      </p>
    </Fragment>
  </Hero>

  <!-- Gynecology Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Jährliche gynäkologische Untersuchung und Abstriche',
        description:
          'Wir führen jährliche gynäkologische Untersuchungen und Abstriche durch, um die Gesundheit und das Wohlbefinden unserer Patientinnen zu gewährleisten.',
        icon: 'tabler:wand',
      },
      {
        title: 'Studie zum Östrogenstoffwechsel',
        description:
          'Wir führen Studien zum Östrogenstoffwechsel durch, um die hormonelle Gesundheit unserer Patientinnen besser zu verstehen.',
        icon: 'tabler:settings',
      },
      {
        title: 'Untersuchung des bakteriellen Gleichgewichts der Vagina',
        description:
          'Wir untersuchen das Gleichgewicht der vaginalen Bakterien, um die vaginale Gesundheit unserer Patientinnen besser zu verstehen.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Darmdysbiose. Lernen Sie Ihre Mikrobiota kennen',
        description:
          'Wir führen Darmdysbiose-Untersuchungen durch, um die Mikrobiota unserer Patientinnen besser zu verstehen.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: '~/assets/images/ginecologia.webp',
      alt: 'Integrative gynäkologische Beratung',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Gynäkologie
      </h3>
    </Fragment>
  </Content>

  <!-- Nutrition Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Personalisierte Ernährungspläne',
        description:
          'Wir erstellen personalisierte Ernährungspläne für jeden Patienten, angepasst an seine spezifischen Bedürfnisse und Ziele.',
        icon: 'tabler:list',
      },
      {
        title: 'Ernährungsberatung für verschiedene Lebensphasen',
        description:
          'Wir bieten eine an die verschiedenen Lebensphasen angepasste Ernährungsberatung an, um gesunde Gewohnheiten und ein ganzheitliches Wohlbefinden zu fördern.',
        icon: 'tabler:school',
      },
      {
        title: 'Diätetische Behandlung von Pathologien (Diabetes, Adipositas, etc.)',
        description:
          'Wir bieten eine spezialisierte diätetische Behandlung für verschiedene Pathologien an, einschließlich Diabetes, Adipositas und andere Erkrankungen, angepasst an die individuellen Bedürfnisse.',
        icon: 'tabler:health-recognition',
      },
      {
        title: 'Beratung zu Nahrungsergänzung und gesunden Gewohnheiten',
        description:
          'Wir bieten Beratung zu Nahrungsergänzungsmitteln und gesunden Gewohnheiten an, um das allgemeine Wohlbefinden unserer Patientinnen zu verbessern.',
        icon: 'tabler:treadmill',
      },
    ]}
    image={{
      src: '~/assets/images/nutricion.webp',
      alt: 'Personalisierte Ernährungsberatung',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Ernährung
      </h3>
    </Fragment>
  </Content>

  <!-- Physiotherapy Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Beckenbodentraining',
        description:
          'Wir bieten personalisierte Beckenboden-Rehabilitationsprogramme an, um die Funktion und das Wohlbefinden unserer Patientinnen zu verbessern.',
        icon: 'tabler:wand',
      },
      {
        title: 'Behandlung von Muskel- und Gelenkschmerzen',
        description:
          'Wir bieten spezialisierte Behandlungen für Muskel- und Gelenkschmerzen an, die auf die individuellen Bedürfnisse jeder Patientin zugeschnitten sind.',
        icon: 'tabler:settings',
      },
      {
        title: 'Physiotherapie für Schwangerschaft und nach der Geburt',
        description:
          'Wir bieten spezialisierte Physiotherapieprogramme für die Schwangerschaft und die Zeit nach der Geburt an, die auf die individuellen Bedürfnisse jeder Patientin zugeschnitten sind.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Funktionelle Erholungsübungen und Verletzungsprävention',
        description:
          'Wir bieten funktionelle Erholungsübungen und Programme zur Verletzungsprävention an, die auf die individuellen Bedürfnisse jeder Patientin zugeschnitten sind.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: '~/assets/images/fisioterapia.webp',
      alt: 'Physiotherapie- und Beckenbodensitzung',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Physiotherapie
      </h3>
    </Fragment>
  </Content>

  <!-- Obstetrics Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Ganzheitliche Schwangerschaftsbegleitung',
        description:
          'Persönliche medizinische Begleitung in allen Phasen der Schwangerschaft, um die Gesundheit von Mutter und Kind zu gewährleisten.',
        icon: 'tabler:heart-plus',
      },
      {
        title: 'Beratung und Klärung von Fragen',
        description:
          'Wir bieten einen vertrauensvollen Raum, um all Ihre Sorgen über die Schwangerschaft, die Entwicklung des Babys und die Veränderungen in Ihrem Körper zu besprechen.',
        icon: 'tabler:message-2',
      },
      {
        title: 'Vorsorgeuntersuchung und Diagnose',
        description:
          'Wir führen die notwendigen Tests und Untersuchungen durch, um die Entwicklung der Schwangerschaft zu überwachen und die Sicherheit der werdenden Eltern zu gewährleisten.',
        icon: 'tabler:stethoscope',
      },
      {
        title: 'Wochenbettbetreuung',
        description:
          'Medizinische Nachsorge nach der Geburt, um eine optimale Erholung zu gewährleisten und die Mutter in den ersten Wochen nach der Entbindung zu begleiten.',
        icon: 'tabler:nurse',
      },
    ]}
    image={{
      src: '~/assets/images/obstetricia.webp',
      alt: 'Schwangerschaftsbegleitung und pränatale Beratung',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 text-center sm:text-left">
        Geburtshilfe
      </h3>
    </Fragment>
  </Content>

  <!-- Online Consultation Hero -->
  <Hero
    tagline=""
    title="Online-Beratungsdienst"
    subtitle="Wir stellen Ihnen einen medizinischen Online-Beratungsdienst zur Verfügung, der Sie begleiten und alle Ihre Fragen zur Frauengesundheit klären soll, ohne dass Sie reisen müssen. <br /> <br />
Durch eine direkte Videoberatung mit Dr. Palenzuela können Sie eine personalisierte Beratung erhalten, Testergebnisse auswerten oder Symptome besprechen, die Sie beunruhigen, und das alles bequem und privat von zu Hause aus. <br /><br />
Ideal für Nachsorgeberatungen, die Überprüfung von Analysen oder die Bewertung von Behandlungen."
    actions={[]}
    image={{
      src: '~/assets/images/consulta-online.webp',
      alt: 'Dr. Palenzuela bei einer medizinischen Online-Beratung',
    }}
  />

  <!-- BlogLatestPost Widget ******* -->
  <BlogLatestPosts title="Mehr Inhalte in unserem Blog" />
</Layout>
