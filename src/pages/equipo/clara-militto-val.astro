---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Clara Militto Val - Clínica Alexandra Palenzuela',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->
  <Hero id="hero" title="Clara Militto Val" tagline='<span style="color: #EB9C9B">Fisioterapeuta</span>' />

  <!-- Content Widget **************** -->
  <Content
    id="about"
    image={{
      src: '~/assets/images/clara.webp',
      alt: 'Imagen Clara Militto Val',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>

      <p class="mb-4">
        Fisioterapeuta comprometida con la recuperación y el bienestar de sus pacientes, especializada en la valoración
        y tratamiento personalizado de diversas patologías.
      </p>

      <p class="mb-4">
        Aplica técnicas avanzadas de terapia manual, ejercicio terapéutico y el servicio de NESA, orientado a optimizar
        los resultados, reducir el dolor y mejorar la calidad de vida a través del movimiento.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    id="experience"
    title="Experiencia laboral"
    items={[
      {
        title: 'Servicio a domicilio de fisioterapia',
        description: `Ofrecemos servicios de fisioterapia a domicilio para brindar comodidad y atención personalizada`,
        icon: 'tabler:briefcase',
      },
      {
        title: 'Clínica de Fisioterapia LAE',
        description: `En nuestra clínica de fisioterapia, nos dedicamos a mejorar la salud `,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl', items: { icon: 'text-[#EB9C9B] border-[#EB9C9B]' } }}
  />

  <!-- Steps Widget ****************** -->
  <Steps
    id="education"
    title="Educación"
    items={[
      {
        title: 'Formación interna LAE <br /> <span class="font-normal">Clínica de Fisioterapia LAE</span>',
        icon: 'tabler:school',
      },
      {
        title: 'Monográficos',
        icon: 'tabler:school',
      },
      {
        title: 'Grado en Fisioterapia <br /> <span class="font-normal">Universidad de La Laguna</span>',
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl', items: { icon: 'text-[#EB9C9B] border-[#EB9C9B]' } }}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts id="blog" title="Descubre más información en nuestro blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</PageLayout>
