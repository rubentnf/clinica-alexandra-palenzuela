---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/Layout.astro';
import { headerData, footerData } from '~/navigation';

const metadata = {
  title: 'Rita Morales Hernández - Clínica Alexandra Palenzuela',
};
---

<Layout metadata={metadata}>
  <Header
    links={[...headerData.links, { text: 'Sobre mí', href: '#about' }, { text: 'Trayectoria', href: '#experience' }]}
    actions={[
      {
        text: 'Pedir cita',
        href: 'https://portal.clinicaenlanube.com/clinicas/925/cita_peticiones/new',
      },
    ]}
    isSticky
    showToggleTheme
    position="center"
  />

  <!-- Hero2 Widget ******************* -->
  <Hero id="hero" title="Rita Morales" tagline="Nutricionista" />

  <!-- Content Widget **************** -->
  <Content
    id="about"
    image={{
      src: '~/assets/images/rita.webp',
      alt: 'Imagen Rita Morales',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>

      <p>
        Especialista en Nutrición Humana y Dietética, dedicada a mejorar la salud a través de una alimentación
        equilibrada y personalizada.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Experiencia Laboral Widget ****************** -->
  <!--  <Steps
    id="experience"
    title="Experiencia laboral"
    items={[
      {
        title:
          'Control de la diabetes gestacional <br /> <span class="font-normal">Hospital de Vall`s de Hebrón</span> <br /> <span class="text-sm font-normal">2018 - 2021</span>',
        description: ``,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  /> -->

  <!-- Steps Widget ****************** -->
  <Steps
    id="education"
    title="Educación"
    items={[
      {
        title:
          'Máster Universitario en Entrenamiento y Nutrición Deportiva <br /> <span class="font-normal">Universidad Europea de Madrid</span>',
        description: ``,
        icon: 'tabler:school',
      },
      {
        title:
          'Graduada en Nutrición Humana y Dietética <br /> <span class="font-normal">Universidad Fernando Pessoa-Canarias (UFP-C)</span>',
        description: ``,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts id="blog" title="Descubre más información en nuestro blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
  <Footer {...footerData} />
</Layout>
