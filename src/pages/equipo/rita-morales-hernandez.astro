---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Rita Morales Hernández - Clínica Alexandra Palenzuela',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->
  <Hero id="hero" title="Rita Morales" tagline='<span style="color: #EB9C9B">Nutricionista</span>' />

  <!-- Content Widget **************** -->
  <Content
    id="about"
    image={{
      src: '~/assets/images/rita.webp',
      alt: 'Rita Morales',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>

      <p class="mb-4">
        Especialista en Nutrición Humana y Dietética, así como en Entrenamiento y Nutrición Deportiva, enfocada en
        mejorar la salud y el rendimiento a través de una alimentación equilibrada, personalizada y sostenible.
      </p>
      <p class="mb-4">
        Su filosofía se basa en un asesoramiento nutricional totalmente adaptado a cada paciente, comprendiendo sus
        necesidades, estilo de vida y objetivos. Más allá de pautas estrictas, apuesta por la educación nutricional,
        ayudando a que cada persona entienda que no se trata de seguir dietas temporales, sino de adquirir hábitos
        saludables duraderos que conduzcan a una salud óptima a lo largo de la vida.
      </p>

      <p class="mb-4">
        Acompaña a sus pacientes en cada etapa, ofreciendo apoyo cercano y continuo para lograr cambios reales,
        sostenibles y alineados con su bienestar.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    id="education"
    title="Educación"
    items={[
      {
        title:
          'Máster Universitario en Entrenamiento y Nutrición Deportiva <br /> <span class="font-normal">Universidad Europea de Madrid</span>',
        description: ``,
        icon: 'tabler:school',
      },
      {
        title:
          'Graduada en Nutrición Humana y Dietética <br /> <span class="font-normal">Universidad Fernando Pessoa-Canarias (UFP-C)</span>',
        description: ``,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl', items: { icon: 'text-[#EB9C9B] border-[#EB9C9B]' } }}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts id="blog" title="Descubre más información en nuestro blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</PageLayout>
