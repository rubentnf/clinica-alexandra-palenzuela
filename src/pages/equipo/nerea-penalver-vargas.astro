---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/Layout.astro';
import { footerData, headerData } from '~/navigation';

const metadata = {
  title: 'Nerea Peñalver Vargas - Clínica Alexandra Palenzuela',
};
---

<Layout metadata={metadata}>
  <Header
    showLogo={false}
    links={[...headerData.links, { text: 'Sobre mí', href: '#about' }, { text: 'Trayectoria', href: '#experience' }]}
    actions={[
      {
        text: 'Pedir cita',
        href: 'https://portal.clinicaenlanube.com/clinicas/925/cita_peticiones/new',
      },
    ]}
    isSticky
    showToggleTheme
    position="center"
  />

  <!-- Hero2 Widget ******************* -->
  <Hero id="hero" title="Nerea Peñalver Vargas" tagline="Fisioterapeuta" />

  <!-- Content Widget **************** -->
  <Content
    id="about"
    image={{
      src: '~/assets/images/nerea.webp',
      alt: 'Imagen Nerea Peñalver Vargas',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>

      <p>
        Fisioterapeuta dedicada al tratamiento integral del paciente, especializada en la prevención y rehabilitación de
        lesiones para promover una vida activa y saludable.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    id="experience"
    title="Experiencia laboral"
    items={[
      {
        title: 'Fisioterapeuta',
        description: `Información sobre experiencia laboral próximamente.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->
  <Steps
    id="education"
    title="Educación"
    items={[
      {
        title: 'Grado en Fisioterapia',
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts id="blog" title="Descubre más información en nuestro blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
  <Footer {...footerData} />
</Layout>
