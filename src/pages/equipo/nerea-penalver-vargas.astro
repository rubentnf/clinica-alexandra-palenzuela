---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Nerea Peñalver Vargas - Clínica Alexandra Palenzuela',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero id="hero" title="Nerea Peñalver Vargas" tagline='<span style="color: #EB9C9B">Obstetricia y Ginecología</span>' />

  <!-- Content Widget **************** -->
  <Content
    id="about"
    image={{
      src: '~/assets/images/nerea.webp',
      alt: 'Imagen Nerea Peñalver Vargas',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>

      <p>
        Médica especializada en Obstetricia y Ginecología, con una amplia dedicación al seguimiento de embarazos y el
        asesoramiento prenatal. Su compromiso es ofrecer una atención médica de excelencia, basada en la evidencia
        científica y en el respeto a las decisiones de la mujer en cada etapa de su maternidad.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    id="experience"
    title="Experiencia laboral"
    items={[
      {
        title:
          'Médica Especialista en Obstetricia y Ginecología <br /> <span class="font-normal">Hospital Universitario Nuestra Señora de La Candelaria</span>',
        description: 'Desde julio de 2021 hasta la actualidad. Especializada en el control de embarazos y asesoramiento prenatal.',
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl', items: { icon: 'text-[#EB9C9B] border-[#EB9C9B]' } }}
  />

  <!-- Steps Widget ****************** -->
  <Steps
    id="education"
    title="Educación"
    items={[
      {
        title: 'Graduada en Medicina',
        description: 'Universidad Rey Juan Carlos de Madrid',
        icon: 'tabler:school',
      },
      {
        title: 'Médica Especialista en Obstetricia y Ginecología',
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl', items: { icon: 'text-[#EB9C9B] border-[#EB9C9B]' } }}
  />

  <!-- BlogLatestPost Widget **************** -->
  <BlogLatestPosts id="blog" title="Descubre más información en nuestro blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</PageLayout>
