---
import { ANALYTICS } from 'astrowind:config';
---

{
  ANALYTICS?.vendors?.umami?.id ? (
    <script
      defer
      src={ANALYTICS.vendors.umami.src || 'https://cloud.umami.is/script.js'}
      data-website-id={ANALYTICS.vendors.umami.id}
      type={ANALYTICS?.vendors?.umami?.partytown ? 'text/partytown' : undefined}
    />
  ) : null
}
