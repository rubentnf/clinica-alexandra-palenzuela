---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '~/i18n/utils';

const { path = Astro.url.pathname } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = useTranslatedPath(lang);

const segments = path.split('/').filter((s) => s !== '' && s !== 'en' && s !== 'de');
const breadcrumbs = segments.map((segment, index) => {
  const href = p('/' + segments.slice(0, index + 1).join('/'));
  let label = segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');

  // Custom labels (translated)
  if (segment === 'equipo') label = t('nav.equipo');
  if (segment === 'blog') label = t('nav.blog');
  if (segment === 'contacto') label = t('nav.contacto');

  return { label, href };
});
---

<nav class="flex px-4 py-2 text-gray-500 dark:text-slate-400 text-sm overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-3">
    <li class="inline-flex items-center">
      <a href={p('/')} class="inline-flex items-center hover:text-primary dark:hover:text-white transition-colors">
        <Icon name="tabler:home" class="w-4 h-4 mr-1.5" />
        {t('nav.inicio')}
      </a>
    </li>
    {
      breadcrumbs.map((crumb, index) => {
        const isLast = index === breadcrumbs.length - 1;
        
        return (
          <li class="flex items-center">
            <Icon name="tabler:chevron-right" class="w-4 h-4 text-gray-400 mx-1" />
            {isLast ? (
              <span class="ml-1 md:ml-2 font-medium text-gray-800 dark:text-white truncate max-w-[200px] md:max-w-none">
                {crumb.label}
              </span>
            ) : (
              <a
                href={crumb.href}
                class="ml-1 md:ml-2 hover:text-primary dark:hover:text-white transition-colors cursor-pointer"
              >
                {crumb.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
