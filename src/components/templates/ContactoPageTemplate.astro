---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { getContactoContent } from '~/data/contacto';

export interface Props {
  lang: 'es' | 'en' | 'de';
}

const { lang } = Astro.props;
const content = getContactoContent(lang);
---

<Layout metadata={content.metadata}>
  <HeroText tagline={`<span style="color: #EB9C9B">${content.tagline}</span>`} title={content.title} />

  <Features2
    title={content.featuresTitle}
    items={[
      {
        title: content.items.phone,
        description: '644 470 520',
        icon: 'tabler:phone',
        link: 'tel:644470520',
      },
      {
        title: content.items.email,
        description: 'info@casadelaluztenerife.com',
        icon: 'tabler:mail',
        link: 'mailto:info@casadelaluztenerife.com',
      },
      {
        title: content.items.location,
        description: content.items.address,
        icon: 'tabler:map-pin',
        link: 'https://www.google.com/maps/search/?api=1&query=Clínica+Alexandra+Gine+Tenerife',
      },
    ]}
    classes={{ items: { icon: 'text-[#EB9C9B]' } }}
  />

  <div class="text-center mt-12 -mb-8">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{content.mapTitle}</h2>
  </div>

  <div class="flex justify-center my-12 px-4 sm:px-6">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3506.7739157568276!2d-16.318557123681284!3d28.486354575744894!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xc41cddd07cc7ce5%3A0x2dec7fde3243a45!2sCl%C3%ADnica%20Alexandra%20Gine%20%7C%20Tenerife!5e0!3m2!1ses!2ses!4v1776955944239!5m2!1ses!2ses"
      width="100%"
      height="450"
      style="border:0; border-radius: 16px; max-width: 1100px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</Layout>
