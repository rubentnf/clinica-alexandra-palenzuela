---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';
import { getEquipoContent } from '~/data/equipo';

export interface Props {
  lang: 'es' | 'en' | 'de';
}

const { lang } = Astro.props;
const content = getEquipoContent(lang);
---

<PageLayout metadata={content.metadata}>
  <HeroText
    tagline={`<span style="color: #EB9C9B">${content.tagline}</span>`}
    title={content.title}
    subtitle={content.subtitle}
  />

  <section class="relative max-w-7xl mx-auto px-4 sm:px-6 mb-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        content.team.map((member) => (
          <div class="flex flex-col items-center p-6 rounded-lg shadow-lg dark:shadow-none dark:border dark:border-slate-800 bg-white dark:bg-slate-900 transition hover:shadow-xl">
            <div class="relative w-48 h-48 mb-6 overflow-hidden rounded-full border-4" style="border-color: #EB9C9B">
              <Image
                src={member.image.src}
                alt={member.image.alt}
                class="object-cover w-full h-full"
                width={200}
                height={200}
              />
            </div>
            <h3 class="text-xl font-bold mb-2 text-center">{member.name}</h3>
            <p class="text-muted dark:text-slate-400 mb-6 text-center h-12 flex items-center justify-center italic">
              {member.role}
            </p>
            <Button href={getPermalink(member.href)} class="w-full text-sm">
              {content.viewProfile}
            </Button>
          </div>
        ))
      }
    </div>
  </section>
</PageLayout>
